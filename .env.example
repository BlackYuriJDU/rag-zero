# Copie para .env e ajuste. Segredos nunca vão para o git (.env está no .gitignore).

# Banco local (SQLite). O diretório é criado automaticamente.
RAGZERO_DB_PATH=data/rag_zero.db

# Identificação da aplicação nas requisições ao PNCP (educação com APIs públicas)
RAGZERO_USER_AGENT=rag-zero/0.0.1 (+https://github.com/BlackYuriJDU/rag-zero)

# Intervalo mínimo entre requisições, em segundos
RAGZERO_MIN_REQUEST_INTERVAL=0.7

# Modelo de embedding local (fastembed/ONNX). 384 dimensões.
RAGZERO_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Portão de recusa: cobertura IDF mínima dos termos da pergunta no corpus.
RAGZERO_MIN_EVIDENCE_COVERAGE=0.55
RAGZERO_MIN_DENSE_SIMILARITY=0.20
