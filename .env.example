# Copie para .env e ajuste. Segredos nunca vão para o git (.env está no .gitignore).

# Banco (opcional no P0; usado a partir da indexação)
# RAGZERO_DATABASE_URL=postgresql://ragzero:ragzero@localhost:5432/ragzero

# Identificação da aplicação nas requisições ao PNCP (educação com APIs públicas)
RAGZERO_USER_AGENT=rag-zero/0.0.1 (+https://github.com/BlackYuriJDU/rag-zero)

# Intervalo mínimo entre requisições, em segundos
RAGZERO_MIN_INTERVAL=0.7
